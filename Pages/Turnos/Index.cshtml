@page
@model SistemaDeTurnosWeb.Pages.Turnos.IndexModel
@{
    ViewData["Title"] = "Turnos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-calendar-check"></i> Turnos</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo turno
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Turnos.Any())
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Fecha y Hora</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var turno in Model.Turnos)
                    {
                        <tr>
                            <td>@turno.Id</td>
                            <td>@turno.ClienteNombre</td>
                            <td>@turno.ServicioNombre</td>
                            <td>@turno.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    var badgeClass = turno.Estado switch
                                    {
                                        EstadoTurno.Pendiente => "bg-warning text-dark",
                                        EstadoTurno.Confirmado => "bg-info",
                                        EstadoTurno.Realizado => "bg-success",
                                        EstadoTurno.Cancelado => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@turno.Estado</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (turno.Estado == EstadoTurno.Pendiente)
                                    {
                                        <form method="post" asp-page-handler="Realizar" asp-route-id="@turno.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    title="Marcar como realizado">
                                                <i class="bi bi-check-lg"></i> Realizado
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Cancelar" asp-route-id="@turno.Id"
                                              onsubmit="return confirm('¿Cancelar este turno?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    title="Cancelar turno">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No hay turnos registrados.
        <a asp-page="Create">Crear el primer turno</a>
    </div>
}
