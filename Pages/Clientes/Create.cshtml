@page
@model SistemaDeTurnosWeb.Pages.Clientes.CreateModel
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<h1><i class="bi bi-person-plus"></i> Nuevo Cliente</h1>

<form method="post" class="mt-4">
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Cliente.Nombre" class="form-label">Nombre completo</label>
                <input asp-for="Cliente.Nombre" class="form-control" required />
                <span asp-validation-for="Cliente.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Cliente.Telefono" class="form-label">Teléfono <span class="text-muted">(opcional)</span></label>
                <input asp-for="Cliente.Telefono" class="form-control" />
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Guardar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-x-lg"></i> Cancelar
            </a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
